# Server
PORT=4000
NODE_ENV=development

# Frontend origin (for CORS + cookie settings)
FRONTEND_URL=http://localhost:5173

# MongoDB (Atlas free tier works fine)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trichofy

# JWT
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Google Sign-In (from Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

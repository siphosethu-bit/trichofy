# Backend that serves /predict and /weather (and now /auth once merged)
VITE_API_URL=https://trichofy-backend.onrender.com

# Auth endpoints - defaults to VITE_API_URL/auth once you merge the auth
# routes into trichofy-backend. Override if auth is deployed separately.
VITE_AUTH_URL=https://trichofy-backend.onrender.com/auth

# From Google Cloud Console > APIs & Services > Credentials > OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
